
-- ============================================================
-- BASE DE DATOS: OPERADORA MOVIL
-- Curso: Ingeniería Web para Telecomunicaciones 
-- Objetivo: práctica de SELECT, CONCAT, alias, operaciones y fechas
-- Compatible con MySQL 8.x
-- ============================================================

DROP DATABASE IF EXISTS operadora_movil;
CREATE DATABASE operadora_movil
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

USE operadora_movil;

-- ------------------------------------------------------------
-- 1. TABLA CLIENTE
-- ------------------------------------------------------------
CREATE TABLE cliente (
    idCliente INT PRIMARY KEY AUTO_INCREMENT,
    dni VARCHAR(8) NOT NULL UNIQUE,
    nombres VARCHAR(50) NOT NULL,
    apellidos VARCHAR(50) NOT NULL,
    correo VARCHAR(100),
    fechaNacimiento DATE NOT NULL
);

-- ------------------------------------------------------------
-- 2. TABLA PLAN
-- ------------------------------------------------------------
CREATE TABLE plan (
    idPlan INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(50) NOT NULL,
    precioMensual DECIMAL(8,2) NOT NULL,
    gbIncluidos INT NOT NULL,
    minutosIncluidos INT NOT NULL,
    smsIncluidos INT NOT NULL
);

-- ------------------------------------------------------------
-- 3. TABLA LINEA
-- ------------------------------------------------------------
CREATE TABLE linea (
    idLinea INT PRIMARY KEY AUTO_INCREMENT,
    numero VARCHAR(9) NOT NULL UNIQUE,
    fechaActivacion DATE NOT NULL,
    estado VARCHAR(20) NOT NULL,
    idCliente INT NOT NULL,
    idPlan INT NOT NULL,
    CONSTRAINT fk_linea_cliente
        FOREIGN KEY (idCliente) REFERENCES cliente(idCliente),
    CONSTRAINT fk_linea_plan
        FOREIGN KEY (idPlan) REFERENCES plan(idPlan)
);

-- ------------------------------------------------------------
-- 4. TABLA SERVICIO ADICIONAL
-- ------------------------------------------------------------
CREATE TABLE servicio_adicional (
    idServicio INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(60) NOT NULL,
    descripcion VARCHAR(150),
    precioBase DECIMAL(8,2) NOT NULL
);

-- ------------------------------------------------------------
-- 5. RELACION N:M ENTRE LINEA Y SERVICIO ADICIONAL
-- ------------------------------------------------------------
CREATE TABLE linea_servicio (
    idLinea INT NOT NULL,
    idServicio INT NOT NULL,
    fechaContratacion DATE NOT NULL,
    fechaVencimiento DATE,
    precioContratado DECIMAL(8,2) NOT NULL,
    PRIMARY KEY (idLinea, idServicio),
    CONSTRAINT fk_linea_servicio_linea
        FOREIGN KEY (idLinea) REFERENCES linea(idLinea),
    CONSTRAINT fk_linea_servicio_servicio
        FOREIGN KEY (idServicio) REFERENCES servicio_adicional(idServicio)
);

