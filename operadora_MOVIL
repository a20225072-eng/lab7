-- ============================================================
-- CONSULTAS DE EJEMPLO PARA LA CLASE
-- ============================================================

-- 1. SELECT básico
SELECT * FROM cliente;

-- 2. Selección de columnas
SELECT dni, nombres, apellidos
FROM cliente;

-- 3. CONCAT
SELECT dni,
       CONCAT(nombres, ' ', apellidos) AS nombreCompleto
FROM cliente;

-- 4. Operación aritmética
SELECT nombre,
       precioMensual,
       precioMensual * 12 AS precioAnual
FROM plan;

-- 5. Descuento del 20%
SELECT nombre,
       precioMensual,
       precioMensual * 0.20 AS descuento,
       precioMensual * 0.80 AS precioFinal
FROM plan;

-- 6. Funciones de fecha
SELECT numero,
       fechaActivacion,
       DATEDIFF(CURRENT_DATE(), fechaActivacion) AS diasActiva
FROM linea;

-- 7. RETO de la PPT: reporte comercial con 15% de descuento
SELECT nombre AS plan,
       gbIncluidos AS gigabytes,
       precioMensual,
       precioMensual * 12 AS precioAnual,
       precioMensual * 0.15 AS descuento,
       precioMensual * 0.85 AS precioPromocional,
       precioMensual * 0.85 * 12 AS precioAnualPromocional
FROM plan;

